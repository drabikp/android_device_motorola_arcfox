<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-License-Identifier: Apache-2.0

     Keys are Settings.Global names; FlipCallsFragment backs them with a
     PreferenceDataStore, so the defaults live in FlipCallSettings only.
-->
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    android:title="@string/settings_title">

    <SwitchPreference
        android:key="arcfox_flip_answer_on_open"
        android:title="@string/answer_on_open_title"
        android:summary="@string/answer_on_open_summary" />

    <SwitchPreference
        android:key="arcfox_flip_end_call_on_close"
        android:title="@string/end_on_close_title"
        android:summaryOn="@string/end_on_close_summary_on"
        android:summaryOff="@string/end_on_close_summary_off" />

    <Preference
        android:key="footer"
        android:summary="@string/footer"
        android:selectable="false" />
</PreferenceScreen>
