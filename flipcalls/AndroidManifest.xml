<?xml version="1.0" encoding="utf-8"?>
<!--
     SPDX-License-Identifier: Apache-2.0

     Flip-to-answer and close-to-end for arcfox (motorola razr 50 ultra).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.lineageos.arcfox.flipcalls">

    <!-- Telecom binds an InCallService without the UI metadata as NON_UI only
         if its app holds this (InCallController.getInCallServiceType). -->
    <uses-permission android:name="android.permission.CONTROL_INCALL_EXPERIENCE" />
    <!-- TelecomManager.isInEmergencyCall: closing never ends an emergency call. -->
    <uses-permission android:name="android.permission.MODIFY_PHONE_STATE" />
    <!-- The two switches are Settings.Global keys (see FlipCallSettings). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />

    <application
        android:label="@string/app_name"
        android:allowBackup="false"
        android:supportsRtl="true">

        <!-- No METADATA_IN_CALL_SERVICE_UI: the Dialer stays the in-call UI and
             this runs beside it, bound only while there are calls.
             directBootAware because Telecom's query uses default PackageManager
             flags, which before the first unlock match only direct-boot-aware
             components, and a call can ring before anyone unlocks. -->
        <service
            android:name=".FlipCallService"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.InCallService" />
            </intent-filter>
            <!-- Stock does nothing while a VoIP (self-managed) call is in the
                 foreground; to see that, Telecom has to send us those calls. -->
            <meta-data
                android:name="android.telecom.INCLUDE_SELF_MANAGED_CALLS"
                android:value="true" />
        </service>

        <!-- Settings > System > Gestures > Flip phone calls. Injected, so
             Settings itself is not patched. -->
        <activity
            android:name=".FlipCallsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:theme="@android:style/Theme.DeviceDefault.Settings">
            <intent-filter>
                <action android:name="com.android.settings.action.IA_SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="com.android.settings.category"
                android:value="com.android.settings.category.ia.gestures" />
            <meta-data
                android:name="com.android.settings.title"
                android:resource="@string/settings_title" />
            <meta-data
                android:name="com.android.settings.summary"
                android:resource="@string/settings_summary" />
            <meta-data
                android:name="com.android.settings.keyhint"
                android:value="arcfox_flip_calls" />
        </activity>
    </application>
</manifest>
