<?xml version="1.0" encoding="utf-8"?>
<!--
    Foldable framework config for motorola arcfox (Razr 50 Ultra / Razr+ 2024).

    Why this file exists even though fold/device_state_configuration.xml already
    declares PROPERTY_FOLDABLE_HARDWARE_CONFIGURATION_* and
    PROPERTY_FOLDABLE_DISPLAY_CONFIGURATION_* per state:

    Both mechanisms are live in LineageOS 23.2. The new properties are defined in
    frameworks/base/core/java/android/hardware/devicestate/DeviceState.java, but
    the legacy integer arrays below are still referenced across frameworks/base
    (config_foldedDeviceStates in 22 files, config_halfFoldedDeviceStates in 6,
    config_openDeviceStates in 8). Declaring only the properties leaves those
    code paths reading empty arrays.

    Identifiers map to fold/device_state_configuration.xml, which is Motorola's
    own stock table:

        0 CLOSED_HALL       lid shut                    OUTER primary
        1 CLOSED            posture < 45                OUTER primary
        2 TENT              posture <= 90, tent flag    OUTER primary
        3 HALF_OPENED_QVD   posture 45..90              OUTER primary
        4 HALF_OPENED_MAIN  posture 90..180 exclusive   INNER primary
        5 OPENED            posture exactly 180         INNER primary
        6 OPENED_HALL       lid-switch fallback         INNER primary

    Grouping follows the FOLD_IN_CLOSED / FOLD_IN_HALF_OPEN / FOLD_IN_OPEN
    property stock assigns to each state, so the two mechanisms agree.
-->
<resources>
    <!-- States where the device presents as folded: cover display is primary.
         Stock marks all four FOLD_IN_CLOSED + OUTER_PRIMARY. -->
    <integer-array name="config_foldedDeviceStates">
        <item>0</item>
        <item>1</item>
        <item>2</item>
        <item>3</item>
    </integer-array>

    <!-- Half-opened. Only state 4 carries FOLD_IN_HALF_OPEN. Note this is the
         state reached at posture 110, verified physically. -->
    <integer-array name="config_halfFoldedDeviceStates">
        <item>4</item>
    </integer-array>

    <!-- Open: inner display primary. 5 is posture-driven, 6 is the lid-switch
         fallback when posture is unavailable. -->
    <integer-array name="config_openDeviceStates">
        <item>5</item>
        <item>6</item>
    </integer-array>

    <!-- arcfox stock declares no rear-display state. zeekr's tree has a
         REAR_DISPLAY_STATE with FLAG_EMULATED_ONLY; that is a zeekr construct,
         not something arcfox hardware reports. Left empty deliberately. -->
    <!-- arcfox: wake the device when it is opened (states 4 HALF_OPENED_MAIN,
         5 OPENED, 6 OPENED_HALL). Same intent as PROPERTY_POWER_CONFIGURATION_TRIGGER_WAKE
         in fold/device_state_configuration.xml; this array is the pre-migration
         path LogicalDisplayMapper still reads when the device_state_property_migration
         flag is off. Both are set so the behaviour does not depend on the flag. -->
    <integer-array name="config_deviceStatesOnWhichToWakeUp">
        <item>4</item>
        <item>5</item>
        <item>6</item>
    </integer-array>
    <!-- arcfox: the closed states (0 CLOSED_HALL, 1 CLOSED) carry
         PROPERTY_POWER_CONFIGURATION_TRIGGER_SLEEP in fold/device_state_configuration.xml;
         this is the pre-migration equivalent. What folding actually does is then decided
         by the user's "Continue using apps on fold" choice below: Always keeps the cover
         interactive, the default only sleeps when no app holds the screen awake, Never
         locks. TENT (2) is not a sleep state: the phone is folded partially on purpose. -->
    <integer-array name="config_deviceStatesOnWhichToSleep">
        <item>0</item>
        <item>1</item>
    </integer-array>
    <!-- arcfox: expose the AOSP "Continue using apps on fold" setting (Display). Stock offers
         the same three choices from its own cover settings. Its feature flag
         (fold_lock_setting_enabled) is fixed-on in this build. -->
    <bool name="config_fold_lock_behavior">true</bool>

    <integer-array name="config_rearDisplayDeviceStates">
    </integer-array>

    <!-- The cover panel must own its content, not mirror the inner display.
         AOSP defaults config_localDisplaysMirrorContent to true (config.xml:3433).
         With it true, LocalDisplayAdapter.shouldOwnContentOnly() is false, so the
         cover display never gets FLAG_OWN_CONTENT_ONLY, and
         DisplayManagerService.getDisplayIdToMirror() then returns DEFAULT_DISPLAY,
         and DisplayContent.setDisplayMirroring() starts a content-recording
         session that paints the whole inner UI onto the cover panel.
         That is what made the setup wizard, home screen and QS shade all appear on
         the outer screen while the phone was OPEN. It was NOT device-state routing.
         DisplayManager had correctly picked the inner panel as DEFAULT_DISPLAY
         (local:4630947043778501763, layerStack 0, 1080x2640, 420dpi) and the cover
         as non-default logical display 9. XML comments cannot contain a double
         hyphen, hence the prose above avoids it.
         Stock reports FLAG_OWN_CONTENT_ONLY on this panel; every multi-panel port
         has to set this. Independent of the device-state machinery, so it holds
         even while the fold sensors are broken. -->
    <bool name="config_localDisplaysMirrorContent">false</bool>

    <!-- THE BACK GESTURE. Without this there is no navigation bar at all, and
         swiping in from the left edge does nothing.

         AOSP defaults config_showNavigationBar to false (config.xml:2772) and
         expects every device to override it; nothing in device/motorola/ did, and
         qemu.hw.mainkeys is unset, so DisplayPolicy.mHasNavigationBar came out
         false. NavigationBarControllerImpl then returns early from
         canCreateNavBarOrTaskBar(), so EdgeBackGestureHandler.onNavBarAttached()
         and onNavigationModeChanged() never run. Confirmed live on bc23:

             mIsAttached=false   mIsGestureHandlingEnabled=false
             mEdgeWidthLeft=78   mExcludeRegion=SkRegion()

         Note what this rules out: the insets are correct (78 px each side, not
         zero), navigation_mode is 2 (gestural), the gestural overlay is enabled
         and the exclusion region is empty. Only the attach step was missing, and
         dumpsys window confirms there is no navigationBars InsetsSource at all.

         Recents keeps working because it never goes through SystemUI: Launcher3's
         TouchInteractionService installs its own swipe-up gesture monitor spy
         window (visible in dumpsys input as "swipe-up ... ownerPid=launcher3").
         Back is SystemUI's EdgeBackGestureHandler, which was dead. That asymmetry
         is what the bug looked like from the outside.

         Expect after this lands: the gesture home pill appears for the first time,
         and apps get a non-zero bottom navigationBars inset (nonDecorInsets was
         [0,0][0,0] in all four rotations, i.e. apps were drawing to the very
         bottom edge). -->
    <bool name="config_showNavigationBar">true</bool>

    <!-- Default to GESTURE navigation rather than the 3-button bar.
         Requested by the owner after config_showNavigationBar landed.

         Turning the nav bar on exposed a second problem: with a bar finally
         present, NavigationModeController actually ran and resolved the mode from
         resources, and AOSP's default config_navBarInteractionMode is 0
         (3 buttons). The stale navigation_mode=2 that had been sitting in
         Settings.Secure meant nothing, because nothing had ever consumed it.

         NavigationModeController.getCurrentInteractionMode() reads the RESOURCE
         directly (NavigationModeController.java:169-171), not the setting, so
         overriding it here takes effect immediately and does not depend on the 0
         already stored in /data.

         The block below is the full resource set from AOSP's
         NavigationBarModeGesturalOverlay, copied rather than just the mode: that
         overlay changes ten related values together, and taking only
         config_navBarInteractionMode would leave an inconsistent config; most
         visibly config_backGestureInset, which would stay at the 3-button default
         and give a hard-to-grab back edge.

         User choice is preserved: these are baked into framework-res, and a
         runtime RRO takes precedence over a baked-in resource, so switching modes
         in Settings still works. -->
    <integer name="config_navBarInteractionMode">2</integer>
    <bool name="config_navBarCanMove">false</bool>
    <bool name="config_navBarTapThrough">true</bool>
    <bool name="config_imeDrawsImeNavBar">true</bool>
    <dimen name="config_backGestureInset">30dp</dimen>
    <bool name="config_navBarNeedsScrim">false</bool>
    <integer name="config_navBarOpacityMode">2</integer>
    <bool name="config_allowSeamlessRotationDespiteNavBarMoving">true</bool>
    <bool name="config_navBarAlwaysShowOnSideEdgeGesture">true</bool>
    <bool name="config_attachNavBarToAppDuringTransition">true</bool>

    <!-- DISPLAY SHAPE: rounded corners and the punch-hole camera.
         =====================================================================
         We shipped NONE of this, so the framework believed both panels were
         perfect rectangles with no camera. Measured on the running device:

             mDisplayCutout=DisplayCutout{insets=Rect(0, 0 - 0, 0) ... }
             mRoundedCorners=RoundedCorners{[RoundedCorner{position=TopLeft,
                             radius=0, ...}, ... all four radius=0]}

         Consequence is cosmetic but constant: SystemUI insets status-bar content
         by the corner radius and around the cutout, so with both at zero the
         clock is laid out into the physically rounded top-right corner and is
         clipped by the glass.

         Every value below is read out of Motorola's own arcfox overlay in the
         W1UXS36H dump with aapt2, NOT guessed from the spec sheet or measured
         off a photo:
             product/overlay/framework-res__arcfox_g__auto_generated_rro_product.apk
               dimen/rounded_corner_radius             100px
               string/config_mainBuiltInDisplayCutout  "M -45,0 L 45,0 L 45,108 L -45,108 Z"
               string/config_secondaryBuiltInDisplayCutout
                                                       "@bottom M 0,0 L -495,0 L -495,-349 L 0,-349 Z @right"
             vendor/overlay/MotoFrameworkResOverlayVendorCommon.apk
               dimen/rounded_corner_radius             24dp   <- the GENERIC Moto
                                                                 value; arcfox's
                                                                 own 100px wins.

         Note the units: these are px, not dp, and must stay px. The cutout spec
         is in the same pixel space as the panel (1080x2640), and the radius is
         paired with it. Converting to dp at 420dpi would shift both.

         config_mainBuiltInDisplayCutout is centred on x=0 by convention: the
         parser translates it to the top-centre of the display, so the -45..45
         span is a 90px-wide hole, 108px tall. That is the inner panel's
         punch-hole camera. -->
    <dimen name="rounded_corner_radius">100px</dimen>
    <string translatable="false" name="config_mainBuiltInDisplayCutout">M -45,0 L 45,0 L 45,108 L -45,108 Z</string>
    <!-- arcfox cover panel: the camera block is deliberately NOT declared as a
         cutout. Stock's overlay declares it ("@bottom M 0,0 L -495,0 L -495,-349
         L 0,-349 Z @right", 495x349 px at the bottom right), but stock only gets
         away with that because Motorola's framework carries private cover-display
         patches (a 48dp cover nav bar, config_cli_display_cutout_camera_height,
         per-package padding lists) that lay content around the cameras. AOSP has
         none of that: a bottom-edge cutout becomes a full-width 349px safe inset,
         Launcher3's taskbar reports its navigation inset as max(bar, cutout) =
         349px, and apps that pad by systemBars|displayCutout (Settings, every
         edge-to-edge app) end their content and scroll views at y=923. Measured
         2026-09-10/13: the bottom 27% of the panel was dead for scrolling, even on
         the good glass left of the cameras. Reviewed independently: no
         system-level setting keeps content above the cameras AND lets the strip
         scroll; shrinking only the nav inset drops the keyboard onto the cameras.
         The zeekr-style form (absolute path with "@left", rect approximation,
         mask=true) was also tried: on this panel it parsed as a 1272px TOP inset,
         i.e. the whole display. So: no declaration. Apps use the whole panel and
         the camera block occludes the bottom-right corner, which is how the cover
         display looks on stock. -->
    <string translatable="false" name="config_secondaryBuiltInDisplayCutout"></string>

    <!-- arcfox: per-display resource index. This array is the ONLY index source
         DisplayUtils.getDisplayUniqueIdConfigIndex() uses; without it it returns
         -1 and BOTH DisplayCutout and RoundedCorners fall back to the MAIN
         panel's values for every display. Measured consequence: the 1080x1272
         cover panel was being given the inner panel's top-centre punch-hole
         (Rect(495,0-585,108)) and its 100px corner radius, neither of which it
         physically has. It also made config_secondaryBuiltInDisplayCutout below
         dead config: that string is only reachable as index 1.
         Index 0 = inner (port 131), index 1 = outer (port 132).
         Values taken verbatim from Motorola's own arcfox RRO. -->
    <string-array name="config_displayUniqueIdArray" translatable="false">
        <item>local:4630947043778501763</item>
        <item>local:4630947043778501764</item>
    </string-array>

    <!-- arcfox: hinge/crease line for Jetpack WindowManager. Full 1080 width at
         y=1320, the midpoint of the 2640-tall inner panel. Without it apps get
         no FoldingFeature and cannot lay out around the crease. Matches stock. -->
    <string name="config_display_features" translatable="false">fold-[0,1320,1080,1320]</string>

    <!-- arcfox: device-state -> posture map, read by SystemUI
         DevicePostureControllerImpl, WM Shell DevicePostureController and
         Jetpack DeviceStateManagerFoldingFeatureProducer. Empty means every
         state resolves to DEVICE_POSTURE_UNKNOWN. Maps our seven states:
         0-3 closed, 4 half-opened, 5-6 opened. Matches stock. -->
    <string-array name="config_device_state_postures" translatable="false">
        <item>0:1</item>
        <item>1:1</item>
        <item>2:1</item>
        <item>3:1</item>
        <item>4:2</item>
        <item>5:3</item>
        <item>6:3</item>
    </string-array>
</resources>
