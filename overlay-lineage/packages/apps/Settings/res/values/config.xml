<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings overlay for motorola arcfox.
-->
<resources>
    <!-- arcfox: show the LineageOS peak refresh rate list in Display settings
         (PeakRefreshRateListPreferenceController). It writes
         Settings.System.peak_refresh_rate, the same key stock Settings writes
         for its High/Standard choice, and offers every rate the panel reports
         (60, 90, 120, 165). The default comes from config_defaultPeakRefreshRate
         in the framework overlay (120, as stock). The minimum refresh rate list
         stays hidden on purpose: a minimum equal to the peak pins the panel and
         stops it idling down to 24 Hz. -->
    <bool name="config_show_peak_refresh_rate_switch">true</bool>
</resources>
