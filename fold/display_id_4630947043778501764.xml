<!--
    OUTER (cover) display, motorola arcfox (Razr 50 Ultra / Razr+ 2024).

    local:4630947043778501764  port 132  1080x1272  density 360
    "Built-in Screen", type INTERNAL on Android 16.

    Worth noting: on Android 14 stock reported this panel as
    name="HDMI Screen", type=EXTERNAL — a workaround for a framework without
    real flip support. Android 16 classifies it as a genuine internal secondary
    display. If this file is ever back-ported to a 22.x build, expect the
    EXTERNAL classification to matter.

    Flags observed in both versions: FLAG_PRESENTATION, FLAG_OWN_CONTENT_ONLY,
    FLAG_OWN_DISPLAY_GROUP, FLAG_ALLOWED_TO_BE_DEFAULT_DISPLAY. It sits in
    displayGroupId 1, layerStack 1. No cutout.

    The canSetBrightnessViaHwc quirk is carried over from zeekr, which needed it
    on its cover panel. UNVERIFIED on arcfox: if cover-display brightness
    control misbehaves, this line is the first thing to try removing.
-->
<displayConfiguration>
    <name>Outer Display</name>

    <quirks>
        <quirk>canSetBrightnessViaHwc</quirk>
    </quirks>

    <!-- Adaptive brightness. The default light sensor (TCS3720) sits behind the
         INNER panel and reads about 2 lux when folded, so the cover uses the outer
         sensor, stk3bfx, which stock reads as its "rear" light sensor. Stock scales
         that sensor by 0.6 (config_rearLuxScaleFactor) before using it, so this
         curve is stock's (config_autoBrightnessLevels and
         config_autoBrightnessDisplayValuesNits) with every lux threshold divided by
         0.6 and every nits target turned into a brightness value through the panel
         map (config_screenBrightnessNits and config_screenBrightnessBacklight,
         (backlight - 1) / 254). Stock's 5500 lux cap is not applied: in stock it
         limits the rear sensor's help to the inner screen, which faces the other
         way. -->
    <autoBrightness enabled="true">
        <luxToBrightnessMapping>
            <map>
                <point><first>0.0</first><second>0.0236</second></point>
                <point><first>3.3</first><second>0.0984</second></point>
                <point><first>6.7</first><second>0.1299</second></point>
                <point><first>16.7</first><second>0.2008</second></point>
                <point><first>33.3</first><second>0.3307</second></point>
                <point><first>66.7</first><second>0.3701</second></point>
                <point><first>166.7</first><second>0.3858</second></point>
                <point><first>541.7</first><second>0.4173</second></point>
                <point><first>2083.3</first><second>0.5512</second></point>
                <point><first>5833.3</first><second>0.7717</second></point>
                <point><first>8333.3</first><second>0.8228</second></point>
                <point><first>16666.7</first><second>0.8622</second></point>
                <point><first>33333.3</first><second>0.8819</second></point>
                <point><first>50000.0</first><second>0.9016</second></point>
                <point><first>333333.3</first><second>1.0000</second></point>
            </map>
        </luxToBrightnessMapping>
    </autoBrightness>

    <lightSensor>
        <type>com.motorola.sensor.alternate_light</type>
        <name>stk_stk3bfx Alt Ambient Light Sensor Non-wakeup</name>
    </lightSensor>

    <densityMapping>
        <density>
            <width>1080</width>
            <height>1272</height>
            <density>360</density>
        </density>
    </densityMapping>
    <!-- Brightness while dozing (always-on display), scale [0, 1]. This wins over
         the framework's config_screenBrightnessDozeFloat. Kept per panel so it can
         be tuned with a vendor remount and a reboot. The cover's lp2 command also
         sets its own brightness (51 03 e8) in DOZE_SUSPEND. -->
    <defaultDozeBrightness>0.05</defaultDozeBrightness>
</displayConfiguration>
